# Optional defaults for managed Tauri builds. If omitted, the app asks on first launch.
# Do not include /api/v1 in the backend address.
VITE_API_BASE_URL=https://fuze.example.com
VITE_FRONTEND_BASE_URL=https://fuze.example.com

# Used only by Vite development when VITE_API_BASE_URL is unset.
API_PROXY_TARGET=http://127.0.0.1:8000
