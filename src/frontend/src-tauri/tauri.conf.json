{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Fuze",
  "version": "0.1.0",
  "identifier": "app.fuze.player",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:desktop"
  },
  "app": {
    "windows": [
      {
        "title": "Fuze",
        "width": 1440,
        "height": 900,
        "minWidth": 360,
        "minHeight": 640,
        "backgroundColor": "#0a0a0b",
        "decorations": false,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; connect-src 'self' ipc: http://ipc.localhost http://localhost:* http://127.0.0.1:* https:; img-src 'self' asset: http: https: data: blob:; media-src 'self' asset: http: https: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
